    <!-- Scripts de Interactividad -->
    <script>
        // Menú Móvil Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Tabs de Servicios
        function switchTab(tab) {
            const btnComerciales = document.getElementById('btn-tab-comerciales');
            const btnProbono = document.getElementById('btn-tab-probono');
            const tabComerciales = document.getElementById('tab-comerciales');
            const tabProbono = document.getElementById('tab-probono');

            if (tab === 'comerciales') {
                tabComerciales.classList.remove('hidden');
                tabProbono.classList.add('hidden');
                
                btnComerciales.classList.add('border-brand-gold', 'text-brand-navy');
                btnComerciales.classList.remove('border-transparent', 'text-slate-500');

                btnProbono.classList.remove('border-brand-gold', 'text-brand-navy');
                btnProbono.classList.add('border-transparent', 'text-slate-500');
            } else {
                tabComerciales.classList.add('hidden');
                tabProbono.classList.remove('hidden');

                btnProbono.classList.add('border-brand-gold', 'text-brand-navy');
                btnProbono.classList.remove('border-transparent', 'text-slate-500');

                btnComerciales.classList.remove('border-brand-gold', 'text-brand-navy');
                btnComerciales.classList.add('border-transparent', 'text-slate-500');
            }
        }

        // Simulación de Reproducción de Video IA
        function playAiVideo() {
            document.getElementById('video-overlay').classList.add('hidden');
            document.getElementById('video-playing').classList.remove('hidden');
        }

        function stopAiVideo() {
            document.getElementById('video-playing').classList.add('hidden');
            document.getElementById('video-overlay').classList.remove('hidden');
        }

        // Lógica del Chatbot Asistente IA
        function toggleChatbot() {
            const modal = document.getElementById('chatbot-modal');
            modal.classList.toggle('hidden');
        }

        function sendMessage() {
            const input = document.getElementById('chat-input');
            const query = input.value.trim();
            if (!query) return;

            appendUserMessage(query);
            input.value = '';
            
            setTimeout(() => {
                processBotResponse(query);
            }, 600);
        }

        function handleKeyPress(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        }

        function sendQuickQuery(queryText) {
            appendUserMessage(queryText);
            setTimeout(() => {
                processBotResponse(queryText);
            }, 500);
        }

        function appendUserMessage(msg) {
            const container = document.getElementById('chat-messages');
            const html = `
                <div class="flex items-start gap-2 justify-end">
                    <div class="bg-brand-forest text-white p-3 rounded-2xl rounded-tr-none text-xs max-w-[85%] shadow-sm">
                        ${escapeHtml(msg)}
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', html);
            container.scrollTop = container.scrollHeight;
        }

        function processBotResponse(query) {
            const container = document.getElementById('chat-messages');
            let responseText = '';
            let showCta = true;

            const q = query.toLowerCase();

            if (q.includes('maltrato') || q.includes('ley 30407') || q.includes('denunciar')) {
                responseText = " Para casos de maltrato animal bajo la Ley N° 30407: Se debe interponer denuncia ante la Comisaría (PNP) o Fiscalía penal. Es vital contar con pruebas (fotos, videos, reporte de veterinario colegiado). Nuestro estudio ofrece orientación y patrocinio en casos graves.";
            } else if (q.includes('comercial') || q.includes('empresa') || q.includes('contrato')) {
                responseText = " En el área comercial asesoramos en constitución de empresas, estatutos, contratos civiles, laboral patronal y patrocinio procesal regular dirigido por el Dr. Martín Mendoza.";
            } else if (q.includes('pro bono') || q.includes('albergue') || q.includes('gratis')) {
                responseText = " Nuestro programa Pro Bono evalúa casos de extrema crueldad o patrocinio a refugios animalistas registrados sin fines de lucro. Requiere previa evaluación de requisitos de elegibilidad.";
            } else {
                responseText = " Gracias por tu consulta. Como asistente automatizado solo puedo brindarte información general y clasificatoria.";
            }

            const ctaButton = showCta ? `
                <div class="mt-3 pt-2 border-t border-slate-200 flex flex-col gap-1.5">
                    <a href="https://wa.me/51987654321?text=Hola,%20fui%20derivado%20por%20el%20asistente%20IA" target="_blank" class="bg-emerald-600 text-white font-bold py-1.5 px-3 rounded text-[11px] text-center flex items-center justify-center gap-1.5">
                        <i class="fa-brands fa-whatsapp text-xs"></i> Hablar con Abogado Humano (WhatsApp)
                    </a>
                    <a href="#contacto" onclick="toggleChatbot()" class="bg-slate-800 text-slate-200 font-medium py-1.5 px-3 rounded text-[11px] text-center">
                        Ir al Formulario de Contacto
                    </a>
                </div>
            ` : '';

            const html = `
                <div class="flex items-start gap-2">
                    <div class="w-7 h-7 rounded-full bg-brand-navy text-brand-gold flex items-center justify-center shrink-0 font-bold text-[10px]">IA</div>
                    <div class="bg-white p-3 rounded-2xl rounded-tl-none border border-slate-200 text-slate-700 shadow-sm max-w-[85%]">
                        ${responseText}
                        ${ctaButton}
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', html);
            container.scrollTop = container.scrollHeight;
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        // Modal de Política de Privacidad
        function openPrivacyModal() {
            document.getElementById('privacy-modal').classList.remove('hidden');
        }

        function closePrivacyModal() {
            document.getElementById('privacy-modal').classList.add('hidden');
        }

        // Envío Formulario Contacto
        function handleFormSubmit(e) {
            e.preventDefault();
            document.getElementById('contact-form').reset();
            const successMsg = document.getElementById('form-success-msg');
            successMsg.classList.remove('hidden');
            setTimeout(() => {
                successMsg.classList.add('hidden');
            }, 6000);
        }
